# GEMINI_API_KEY: Required for the live AI crop-quality scan feature.
# Get a free key at https://aistudio.google.com/apikey
# This key is only ever read server-side by api/analyze-crop.js — it is
# NEVER bundled into the frontend, so it stays safe from prying eyes.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# Optional: override the default vision model (gemini-3.5-flash).
# GEMINI_VISION_MODEL="gemini-3.1-flash-lite"

# VITE_GOOGLE_CLIENT_ID: Enables the "Sign in with Google" button.
# This is a PUBLIC identifier (not a secret) — it's fine that it ships in
# the frontend bundle, unlike GEMINI_API_KEY above.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an "OAuth 2.0 Client ID" of type "Web application"
# 3. Under "Authorized JavaScript origins" add http://localhost:3000
#    (and later your real Vercel domain, e.g. https://your-app.vercel.app)
# 4. Copy the Client ID below. If left blank, the Google button is simply
#    hidden and the rest of sign-in (mobile/OTP/demo) works as normal.
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID_HERE.apps.googleusercontent.com"
